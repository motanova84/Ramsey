{
  "name": "ramsey",
  "version": "1.0.0",
  "description": "AIK Beacons - Proof of Mathematical Truth NFT Integration for Ramsey Theory",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "example": "examples",
    "test": "tests"
  },
  "scripts": {
    "compile": "hardhat compile --config hardhat.config.cjs",
    "test": "hardhat test nft/tests/test-mint.js --config hardhat.config.cjs",
    "deploy:testnet": "hardhat run nft/scripts/deploy.js --network baseTestnet --config hardhat.config.cjs",
    "deploy:mainnet": "hardhat run nft/scripts/deploy.js --network baseMainnet --config hardhat.config.cjs",
    "mint": "node nft/scripts/mint-nft.js",
    "batch-mint": "node nft/scripts/batch-mint.js",
    "prepare-metadata": "node nft/scripts/upload-to-ipfs.js"
  },
  "keywords": [
    "nft",
    "ethereum",
    "base",
    "ramsey-theory",
    "mathematics",
    "proof",
    "qcal"
  ],
  "author": "José Manuel Mota Burruezo (JMMB Ψ✧∴)",
  "license": "MIT",
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.0",
    "@nomicfoundation/hardhat-ethers": "^3.1.2",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "@nomicfoundation/hardhat-verify": "^2.1.3",
    "@openzeppelin/contracts": "^5.4.0",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "chai": "^4.5.0",
    "dotenv": "^17.2.3",
    "ethers": "^6.15.0",
    "hardhat": "^2.22.18",
    "hardhat-gas-reporter": "^1.0.10",
    "pinata": "^2.5.1",
    "solidity-coverage": "^0.8.16",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript": "^5.9.3"
  }
}
