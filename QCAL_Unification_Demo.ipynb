    "# Get all connections\n",
    "connections = framework.get_all_connections()\n",
    "\n",
    "# Create connection matrix for visualization\n",
    "problems = list(framework.problems.keys())\n",
    "n = len(problems)\n",
    "connection_matrix = np.zeros((n, n))\n",
    "\n",
    "for i, prob_i in enumerate(problems):\n",
    "    for j, prob_j in enumerate(problems):\n",
    "        if prob_j in connections[prob_i]:\n",
    "            connection_matrix[i, j] = 1\n",
    "\n",
    "# Plot connection matrix\n",
    "fig, ax = plt.subplots(figsize=(10, 8))\n",
    "im = ax.imshow(connection_matrix, cmap='Blues', aspect='auto')\n",
    "\n",
    "# Set ticks and labels\n",
    "ax.set_xticks(np.arange(n))\n",
    "ax.set_yticks(np.arange(n))\n",
    "ax.set_xticklabels([framework.problems[p]['name'] for p in problems], rotation=45, ha='right')\n",
    "ax.set_yticklabels([framework.problems[p]['name'] for p in problems])\n",
    "\n",
    "# Add text annotations\n",
    "for i in range(n):\n",
    "    for j in range(n):\n",
    "        if connection_matrix[i, j] > 0:\n",
    "            text = ax.text(j, i, '✓', ha='center', va='center', color='white', fontsize=16)\n",
    "\n",
    "ax.set_title('QCAL Problem Connection Matrix', fontsize=14, fontweight='bold')\n",
    "plt.colorbar(im, ax=ax, label='Connected')\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "print(\"\\n📊 Connection Summary:\")\n",
    "total_connections = int(np.sum(connection_matrix))\n",
    "print(f\"  Total connections: {total_connections}\")\n",
    "print(f\"  Average connections per problem: {total_connections/n:.2f}\")"
