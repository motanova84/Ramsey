    "class QCALUnificationDemo:\n",
    "    \"\"\"Interactive dashboard for QCAL connections.\"\"\"\n",
    "    \n",
    "    def __init__(self, framework):\n",
    "        self.framework = framework\n",
    "        self.problems = [\n",
    "            \"P vs NP\", \"Riemann Hypothesis\", \"BSD Conjecture\",\n",
    "            \"Navier-Stokes\", \"Ramsey Numbers\", \"Yang-Mills\", \"Hodge Conjecture\"\n",
    "        ]\n",
    "        self.problem_map = {\n",
    "            \"P vs NP\": \"p_vs_np\",\n",
    "            \"Riemann Hypothesis\": \"riemann\",\n",
    "            \"BSD Conjecture\": \"bsd\",\n",
    "            \"Navier-Stokes\": \"navier_stokes\",\n",
    "            \"Ramsey Numbers\": \"ramsey\",\n",
    "            \"Yang-Mills\": \"yang_mills\",\n",
    "            \"Hodge Conjecture\": \"hodge\"\n",
    "        }\n",
    "    \n",
    "    def create_dashboard(self):\n",
    "        \"\"\"Create interactive dashboard.\"\"\"\n",
    "        problem_selector = widgets.Dropdown(\n",
    "            options=self.problems,\n",
    "            description='Problem:',\n",
    "            style={'description_width': 'initial'}\n",
    "        )\n",
    "        \n",
    "        visualize_btn = widgets.Button(\n",
    "            description=\"Show QCAL Connection\",\n",
    "            button_style='info'\n",
    "        )\n",
    "        \n",
    "        output = widgets.Output()\n",
    "        \n",
    "        def on_visualize(b):\n",
    "            with output:\n",
    "                output.clear_output()\n",
    "                problem = problem_selector.value\n",
    "                self.show_qcal_connection(problem)\n",
    "        \n",
    "        visualize_btn.on_click(on_visualize)\n",
    "        \n",
    "        display(widgets.VBox([\n",
    "            widgets.HTML(\"<h3>QCAL Problem Explorer</h3>\"),\n",
    "            problem_selector,\n",
    "            visualize_btn,\n",
    "            output\n",
    "        ]))\n",
    "    \n",
    "    def show_qcal_connection(self, problem_name):\n",
    "        \"\"\"Display how problem connects through QCAL.\"\"\"\n",
    "        problem_key = self.problem_map[problem_name]\n",
    "        connections = self.get_qcal_connections(problem_key)\n",
    "        \n",
    "        md_output = f\"\"\"\n",
    "## {problem_name} in QCAL Unified Framework\n",
    "\n",
    "**QCAL Operator**: `{connections['operator']}`\n",
    "\n",
    "**Universal Constant**: `{connections['constant']}`\n",
    "\n",
    "**Problem Statement**: {connections['statement']}\n",
    "\n",
    "**Connection Equation**:\n",
    "```\n",
    "{connections['equation']}\n",
    "```\n",
    "\n",
    "**Verification Protocol**: {connections['verification']}\n",
    "\n",
    "**Connected Problems**: {', '.join(connections['connected_to'])}\n",
    "\n",
    "**Verification Status**: {connections['status']}\n",
    "        \"\"\"\n",
    "        \n",
    "        display(Markdown(md_output))\n",
    "    \n",
    "    def get_qcal_connections(self, problem_key):\n",
    "        \"\"\"Get connection details for a problem.\"\"\"\n",
    "        metadata = self.framework.problem_metadata.get(problem_key, {})\n",
    "        \n",
    "        # Get connections\n",
    "        connected_to = self.framework._find_connections(problem_key)\n",
    "        connected_names = [self.framework.problem_metadata[k]['name'] \n",
    "                          for k in connected_to]\n",
    "        \n",
    "        # Get verification status\n",
    "        status = self.framework._verify_problem(problem_key)\n",
    "        \n",
    "        # Create equation based on problem\n",
    "        equations = {\n",
    "            'p_vs_np': 'D_PNP(φ) = κ_Π · log(tw(G_I(φ))) ≥ κ_Π · tw(φ)/log(n)',\n",
    "            'riemann': 'H_Ψ(z) = 0 ↔ Re(z) = 1/2, Im(z) = 2πf₀',\n",
    "            'bsd': 'L_E(1) = Δ · Ω_E · Reg_E · ∏_p c_p / |E_tors|²',\n",
    "            'navier_stokes': '∂u/∂t + (u·∇)u = -∇p + ν∇²u + ε·R_QCAL[u]',\n",
    "            'ramsey': 'R_ψ(r,s) = O(√(rs) · ln(rs)) via f₀ = 141.7 Hz',\n",
    "            'yang_mills': 'Mass gap = g_YM · f₀ / 100 GeV',\n",
    "            'hodge': 'h^{1,1} + h^{2,1} = 13 for quintic Calabi-Yau'\n",
    "        }\n",
    "        \n",
    "        return {\n",
    "            'operator': metadata.get('operator', ''),\n",
    "            'constant': metadata.get('constant', ''),\n",
    "            'statement': metadata.get('statement', ''),\n",
    "            'verification': metadata.get('verification', ''),\n",
    "            'connected_to': connected_names,\n",
    "            'status': status,\n",
    "            'equation': equations.get(problem_key, 'N/A')\n",
    "        }\n",
    "\n",
    "# Create and display dashboard\n",
    "demo = QCALUnificationDemo(framework)\n",
    "demo.create_dashboard()"
